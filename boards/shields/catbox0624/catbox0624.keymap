// Planck 4x12 keymap with 2u spacebar (MIT layout)
// 47 logical bindings, 47 physical keys:
//   RC(3,5)=spacebar(2u), RC(3,6)=empty (no switch, not in transform)
// See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <behaviors/rgbled_widget.dtsi>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ╭─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────╮
// │ ESC │  Q  │  W  │  E  │  R  │  T  │  Y  │  U  │  I  │  O  │  P  │BSPC │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │ TAB │  A  │  S  │  D  │  F  │  G  │  H  │  J  │  K  │  L  │SCLN │QUOT │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │LSFT │  Z  │  X  │  C  │  V  │  B  │  N  │  M  │COMMA│ DOT │ UP  │ RET │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │CTRL │GUI  │ALT  │RAISE│LOWER│SPACE (2u) │  /  │     │LEFT │DOWN │RGHT │
// ╰─────┴─────┴─────┴─────┴─────┴─────┬─────┴─────┴─────┴─────┴─────┴─────╯
            bindings = <
    &kp ESC    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P       &kp BSPC
    &kp TAB    &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI    &kp SQT
    &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA   &kp DOT    &kp UP      &kp RET
    &kp LCTRL  &kp LGUI   &kp LALT   &mo 2      &mo 1      &kp SPACE  &kp FSLH    &trans      &kp LEFT   &kp DOWN   &kp RIGHT
            >;
        };

        lower_layer {
// ╭─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────╮
// │  `  │     │     │  (  │  )  │  7  │  8  │  9  │  +  │PGUP │HOME │ DEL │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │     │  [  │  ]  │  4  │  5  │  6  │  -  │PGDN │ END │ INS │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │     │  {  │  }  │  1  │  2  │  3  │  *  │  =  │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │     │ ADJ │     │  0 (2u)   │  .  │  /  │ RET │     │     │
// ╰─────┴─────┴─────┴─────┴─────┴─────┬─────┴─────┴─────┴─────┴─────┴─────╯
            bindings = <
    &kp GRAVE   &trans      &trans      &kp LPAR    &kp RPAR    &kp N7      &kp N8      &kp N9      &kp KP_PLUS     &kp PG_UP   &kp HOME    &kp DEL
    &trans      &trans      &trans      &kp LBKT    &kp RBKT    &kp N4      &kp N5      &kp N6      &kp KP_MINUS    &kp PG_DN   &kp END     &kp INS
    &trans      &trans      &trans      &kp LBRC    &kp RBRC    &kp N1      &kp N2      &kp N3      &kp KP_MULTIPLY &kp KP_EQUAL &trans      &trans
    &trans      &trans      &trans      &mo 3       &trans      &kp N0      &kp DOT     &kp KP_DIVIDE    &kp RET     &trans      &trans
            >;
        };

        raise_layer {
// ╭─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────╮
// │ F1  │ F2  │ F3  │     │     │  &  │  *  │  (  │     │     │     │PrSc │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │ F4  │ F5  │ F6  │     │     │  $  │  %  │  ^  │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │ F7  │ F8  │ F9  │     │     │  !  │  @  │  #  │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │ F10 │ F11 │ F12 │     │ ADJ │   ) (2u)  │  <  │  >  │  ?  │     │     │
// ╰─────┴─────┴─────┴─────┴─────┴─────┬─────┴─────┴─────┴─────┴─────┴─────╯
            bindings = <
    &kp F1      &kp F2      &kp F3      &trans      &trans      &kp AMPERSAND &kp ASTERISK &kp LPAR    &trans      &trans      &trans      &kp PRINTSCREEN
    &kp F4      &kp F5      &kp F6      &trans      &trans      &kp DOLLAR    &kp PERCENT  &kp CARET   &trans      &trans      &trans      &trans
    &kp F7      &kp F8      &kp F9      &trans      &trans      &kp EXCLAMATION &kp AT_SIGN &kp HASH  &trans      &trans      &trans      &trans
    &kp F10     &kp F11     &kp F12     &trans      &mo 3       &kp RPAR      &kp LESS_THAN &kp GREATER_THAN &kp QUESTION &trans      &trans
            >;
        };

        // Adjust layer (3) — activated when LOWER+RAISE are pressed together
        adjust_layer {
// ╭─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────╮
// │ BT0 │ BT1 │ BT2 │     │     │     │     │     │     │     │BOOT │UNLK │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │BATT │CONN │     │     │     │     │     │     │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │     │     │     │     │     │     │     │     │SCRL │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │     │     │     │           │     │     │LFET │DOWN │RGHT │
// ╰─────┴─────┴─────┴─────┴─────┴─────┬─────┴─────┴─────┴─────┴─────┴─────╯
            bindings = <
    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &trans      &trans      &trans      &trans      &trans      &trans      &trans      &bootloader &studio_unlock
    &ind_bat       &ind_con       &trans        &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
    &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &mkp SCRL_UP &trans
    &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &mkp SCRL_LEFT &mkp SCRL_DOWN &mkp SCRL_RIGHT
        >;
    };

    // Reserved layers (4-15) — ZMK Studio can edit these without recompiling
        extra_4  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_5  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_6  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_7  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_8  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_9  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_10 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_11 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_12 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_13 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_14 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_15 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
    };
};
