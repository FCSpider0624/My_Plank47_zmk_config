// Planck 4x12 keymap with 2u spacebar (MIT layout)
// 48 bindings (4x12), 47 physical keys:
//   RC(3,5)=spacebar(2u), RC(3,6)=&none (no physical switch)
// See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <behaviors/rgbled_widget.dtsi>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ╭─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────╮
// │ ESC │  Q  │  W  │  E  │  R  │  T  │  Y  │  U  │  I  │  O  │  P  │BSPC │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │ TAB │  A  │  S  │  D  │  F  │  G  │  H  │  J  │  K  │  L  │SCLN │QUOT │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │LSFT │  Z  │  X  │  C  │  V  │  B  │  N  │  M  │COMMA│ DOT │ UP  │ RET │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │CTRL │GUI  │ALT  │LOWER│RAISE│SPACE (2u) │  /  │     │LEFT │DOWN │RGHT │
// ╰─────┴─────┴─────┴─────┴─────┴─────┬─────┴─────┴─────┴─────┴─────┴─────╯
            bindings = <
    &kp ESC    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P       &kp BSPC
    &kp TAB    &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI    &kp SQT
    &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA   &kp DOT    &kp UP      &kp RET
    &kp LCTRL  &kp LGUI   &kp LALT   &mo 1      &mo 2      &kp SPACE  &none       &kp FSLH    &trans      &kp LEFT   &kp DOWN   &kp RIGHT
            >;
        };

        lower_layer {
// ╭─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────╮
// │  `  │     │     │     │     │  7  │  8  │  9  │BSPC │ DEL │HOME │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │  -  │  =  │  [  │  ]  │  4  │  5  │  6  │ RET │ END │PGUP │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │ BT  │  BT  │MUTE │VOL- │  1  │  2  │  3  │     │PGDN │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │     │     │     │   0 (2u)   │  .  │     │     │ RET │     │
// ╰─────┴─────┴─────┴─────┴─────┴─────┬─────┴─────┴─────┴─────┴─────┴─────╯
            bindings = <
    &kp GRAVE   &trans      &trans      &trans      &trans      &kp N7      &kp N8      &kp N9      &kp BSPC    &kp DEL     &kp HOME    &trans
    &trans        &kp MINUS   &kp EQUAL   &kp LBKT    &kp RBKT    &kp N4      &kp N5      &kp N6      &kp RET     &kp END     &kp PG_UP   &trans
    &trans        &ind_bat    &ind_con    &kp C_MUTE  &kp C_VOL_DN &kp N1      &kp N2      &kp N3      &trans      &kp PG_DN   &trans      &trans
    &trans      &trans      &trans      &trans      &trans      &kp N0      &none       &kp DOT     &trans      &trans      &kp RET     &trans
            >;
        };

        raise_layer {
// ╭─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────╮
// │     │ F1  │ F2  │ F3  │ F4  │ F5  │ F6  │ F7  │ F8  │ F9  │F10  │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │F11  │F12  │     │     │     │     │     │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │     │     │     │     │     │     │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │     │     │     │               │     │     │     │     │     │
// ╰─────┴─────┴─────┴─────┴─────┴─────┬─────────┴─────┴─────┴─────┴─────┴─────╯
            bindings = <
    &trans        &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp F11
    &trans        &kp F12     &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
    &trans        &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
    &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
            >;
        };

        // Reserved layers (3-15) — ZMK Studio can edit these without recompiling
        extra_3  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_4  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_5  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_6  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_7  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_8  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_9  { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_10 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_11 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_12 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_13 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_14 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
        extra_15 { status = "reserved"; bindings = < &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans >; };
    };
};
